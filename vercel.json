{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/registrations.csv",
      "destination": "/api/registrations?format=csv"
    },
    {
      "source": "/admin",
      "destination": "/portal.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    }
  ]
}
